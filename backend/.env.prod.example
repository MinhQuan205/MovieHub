# ─── MovieHub Backend — Production Environment ────────────────────────────────
# Copy this file to backend/.env.prod and fill in all values.
# NEVER commit .env.prod to version control.

NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=https://api.moviehub.com,https://moviehub.com

# ─── Database ────────────────────────────────────────────────────────────────
# Option A: Self-hosted (uses mongo service in docker-compose.prod.yml)
MONGODB_URI=mongodb://mongo:27017/moviehub_prod

# Option B: MongoDB Atlas (comment out the mongo service in docker-compose.prod.yml)
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/moviehub_prod?retryWrites=true&w=majority

DATABASE_CONNECT_RETRIES=5
DATABASE_CONNECT_RETRY_DELAY_MS=3000

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=CHANGE_ME_LONG_RANDOM_64_CHAR_STRING
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_LONG_RANDOM_64_CHAR_STRING
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── TMDB ────────────────────────────────────────────────────────────────────
TMDB_API_KEY=your_tmdb_bearer_token
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p

# ─── Google OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://api.moviehub.com/api/v1/auth/google/callback

# ─── Email / SendGrid ────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.your_sendgrid_key
EMAIL_FROM=noreply@moviehub.com
MOBILE_DEEP_LINK_URL=moviehub://auth/verify

# ─── AWS S3 ──────────────────────────────────────────────────────────────────
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=moviehub-uploads-prod
AWS_S3_PUBLIC_BASE_URL=https://moviehub-uploads-prod.s3.ap-southeast-1.amazonaws.com

# ─── Firebase Admin (FCM Push Notifications) ─────────────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your_project.iam.gserviceaccount.com
# Paste the private key with literal \n (not real newlines)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ─── Elasticsearch ───────────────────────────────────────────────────────────
# Self-hosted (uses elasticsearch service in docker-compose.prod.yml)
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# Option: Elastic Cloud (takes priority over basic auth)
# ELASTICSEARCH_API_KEY=your_elastic_cloud_api_key

# ─── Health ──────────────────────────────────────────────────────────────────
# In production, health endpoint returns 503 if Redis/MongoDB not connected
HEALTH_STRICT_READINESS=true

# ─── Observability (optional) ────────────────────────────────────────────────
SENTRY_DSN=https://xxx@sentry.io/xxx
