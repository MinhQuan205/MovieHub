NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:8081,http://localhost:19006

# Database
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/moviehub?retryWrites=true&w=majority&authSource=admin
# MONGODB_URL is accepted as a legacy alias, but MONGODB_URI is preferred.

# Redis
REDIS_URL=redis://localhost:6379

# Health & Rate Limit
# In staging/production strict readiness is enabled automatically.
# You can force strict mode in other envs with HEALTH_STRICT_READINESS=true.
HEALTH_STRICT_READINESS=false
DATABASE_CONNECT_RETRIES=5
DATABASE_CONNECT_RETRY_DELAY_MS=2000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Auth (JWT)
JWT_ACCESS_SECRET=change_to_long_random_access_secret
JWT_REFRESH_SECRET=change_to_long_random_refresh_secret  
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# TMDB
TMDB_API_KEY=your_tmdb_bearer_token
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p

# Google OAuth
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# Email / SendGrid (Week 2)
SENDGRID_API_KEY=SG.your_key
EMAIL_FROM=noreply@moviehub.com

# AWS S3 (later weeks)
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=moviehub-uploads

# Firebase Admin (later weeks)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@project.iam.gserviceaccount.com

# Elasticsearch (later weeks)
ELASTICSEARCH_URL=http://localhost:9200

# Observability
SENTRY_DSN=https://xxx@sentry.io/xxx
