NODE_ENV=development
PORT=4000
MONGODB_URL=mongodb+srv://<user>:<pass>@<cluster>/moviehub?retryWrites=true&w=majority&authSource=admin

REDIS_URL=redis://localhost:6379
API_PREFIX=/api/v1

# Health & Rate Limit
# In staging/production strict readiness is enabled automatically.
# You can force strict mode in other envs with HEALTH_STRICT_READINESS=true.
HEALTH_STRICT_READINESS=false
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=100

# Auth (JWT)
JWT_ACCESS_SECRET=change_to_long_random_access_secret
JWT_REFRESH_SECRET=change_to_long_random_refresh_secret  
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# TMDB
TMDB_API_KEY=your_tmdb_bearer_token
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE=https://image.tmdb.org/t/p

# Google OAuth
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback